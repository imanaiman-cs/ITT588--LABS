<div class="container py-4">
  <h1 class="page-title">Enforcers</h1>
  <p class="text-muted">The path a victim can take, and the agency responsible at each step.</p>
  <div class="timeline">
    <% [["bi-shield-fill-check", "Report", "Royal Malaysia Police (PDRM)", "Receives police reports and investigates. The D11 Sexual, Women and Child Investigation Division handles these cases."],
        ["bi-hospital", "Medical care", "One Stop Crisis Centre (OSCC)", "At government hospital emergency departments. Gives medical care and connects victims to police and JKM."],
        ["bi-people-fill", "Protection", "Social Welfare Department (JKM)", "Provides shelter, counselling and protection officers, and can issue an Emergency Protection Order."],
        ["bi-bank2", "Court orders", "Courts", "Magistrates and judges issue Interim Protection Orders and Protection Orders and hear criminal cases."],
        ["bi-briefcase-fill", "Harassment cases", "Tribunal for Anti-Sexual Harassment", "Hears sexual harassment complaints under Act 840."]].each_with_index do |(icon, step, title, text), i| %>
      <div class="timeline-item">
        <div class="timeline-dot"><i class="bi <%= icon %>"></i></div>
        <div class="card shadow-sm"><div class="card-body">
          <span class="step-label">Step <%= i + 1 %> · <%= step %></span>
          <h2 class="h5 mt-1"><%= title %></h2>
          <p class="text-muted mb-0"><%= text %></p>
        </div></div>
      </div>
    <% end %>
  </div>
</div>
